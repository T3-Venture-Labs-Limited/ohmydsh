{
  "version": "0.1.9",
  "dsh": "0.2.2-rc.5",
  "node": ">=24",
  "profile": {
    "name": "omd",
    "defaults": "profile/defaults.cordis.yml",
    "official": [
      "@deepseek-ai/dsh-personalized-recommendations",
      "@deepseek-ai/dsh-experimental-voice-input-bundle",
      "@deepseek-ai/dsh-experimental-session-titles-bundle",
      "@deepseek-ai/dsh-experimental-plugin-market-bundle"
    ]
  },
  "plugins": {
    "core": {
      "dsh-plugin-subscriptions": "0.9.14",
      "@kenz1117/dsh-engram": "0.13.15",
      "dsh-context": "0.87.1",
      "dsh-model-logos": "0.8.0",
      "dsh-better-sidebar": "0.32.1",
      "@t3labs/ohmydsh-genui": "0.17.1",
      "dsh-marktext": "0.1.13",
      "@orderg-x/dsh-video-preview": "0.5.7",
      "@zseven-w/dsh-openpencil": "0.1.0-rc.16",
      "dsh-output-styles": "0.8.5",
      "dsh-composer-history": "0.8.19",
      "@hellokidder/dsh-hotkey": "0.0.3",
      "dsh-sentinel": "0.15.0",
      "dsh-notify-me": "1.22.0",
      "@t3labs/ohmydsh-agent-browser": "0.2.8",
      "@t3labs/ohmydsh-studio": "0.1.2",
      "@t3labs/ohmydsh-pwa": "0.3.2",
      "@t3labs/ohmydsh-brand": "0.1.0",
      "@t3labs/ohmydsh-browser-takeover": "0.1.1",
      "@t3labs/ohmydsh-review-comments": "0.2.0",
      "@t3labs/ohmydsh-skill-studio": "0.1.2",
      "@t3labs/ohmydsh-notebook": "0.1.0",
      "@t3labs/ohmydsh-triggers": "0.1.1",
      "@t3labs/ohmydsh-automation-models": "0.1.0"
    },
    "packs": {
      "composio": {
        "@t3labs/ohmydsh-composio": "0.1.1"
      },
      "langfuse": {
        "@t3labs/ohmydsh-langfuse": "0.1.0"
      },
      "parallel": {
        "@t3labs/ohmydsh-web-search-parallel": "0.1.0"
      },
      "omarchy": {
        "@t3labs/ohmydsh-theme": "0.1.3",
        "@t3labs/ohmydsh-hud": "0.1.0"
      }
    }
  },
  "packInfo": {
    "composio": {
      "summary": "Composio apps and triggers",
      "requires": [
        "the Composio CLI, logged in (`composio login`)"
      ]
    },
    "langfuse": {
      "summary": "Langfuse tracing for every agent turn",
      "requires": [
        "LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY in the environment"
      ]
    },
    "parallel": {
      "summary": "Web search and fetch through Parallel",
      "requires": [
        "PARALLEL_API_KEY in the environment"
      ],
      "rows": "profile/packs/parallel.cordis.yml"
    },
    "omarchy": {
      "summary": "Follow your Omarchy theme and a floating quick-prompt HUD",
      "requires": [
        "Omarchy (Hyprland); the HUD also needs the separate dsh-hud-qt app"
      ],
      "rows": "profile/packs/omarchy.cordis.yml"
    }
  },
  "sources": {
    "@t3labs/ohmydsh-studio": {
      "workspace": "packages/studio"
    },
    "@t3labs/ohmydsh-pwa": {
      "workspace": "packages/pwa"
    },
    "@t3labs/ohmydsh-brand": {
      "workspace": "packages/brand"
    },
    "@t3labs/ohmydsh-browser-takeover": {
      "workspace": "packages/browser-takeover"
    },
    "@t3labs/ohmydsh-review-comments": {
      "workspace": "packages/review-comments"
    },
    "@t3labs/ohmydsh-skill-studio": {
      "workspace": "packages/skill-studio"
    },
    "@t3labs/ohmydsh-notebook": {
      "workspace": "packages/notebook"
    },
    "@t3labs/ohmydsh-triggers": {
      "workspace": "packages/triggers"
    },
    "@t3labs/ohmydsh-automation-models": {
      "workspace": "packages/automation-models"
    },
    "@t3labs/ohmydsh-agent-browser": {
      "workspace": "packages/agent-browser"
    },
    "@t3labs/ohmydsh-composio": {
      "workspace": "packages/composio"
    },
    "@t3labs/ohmydsh-langfuse": {
      "workspace": "packages/langfuse"
    },
    "@t3labs/ohmydsh-web-search-parallel": {
      "workspace": "packages/web-search-parallel"
    },
    "@t3labs/ohmydsh-theme": {
      "workspace": "packages/theme"
    },
    "@t3labs/ohmydsh-hud": {
      "workspace": "packages/hud"
    },
    "@t3labs/ohmydsh-genui": {
      "workspace": "packages/genui"
    }
  },
  "patches": {
    "@kenz1117/dsh-engram@0.13.15": {
      "file": "profile/patches/dsh-engram@0.13.15.patch",
      "note": "the memory plugin's start-up pass is delayed by 10 minutes",
      "issue": "https://github.com/kenz1117/dsh-engram/issues/64"
    }
  },
  "allowBuilds": [
    "agent-browser@0.43.0",
    "onnxruntime-node@1.30.0",
    "protobufjs@7.6.6"
  ]
}
