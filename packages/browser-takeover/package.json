{
  "name": "@t3labs/ohmydsh-browser-takeover",
  "version": "0.1.0",
  "description": "Watch the dsh-agent-browser browser live in a right-sidebar tab, take control to sign in, and hand it back; pauses the agent's browser tools while you drive and keeps logins across restarts.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.*js\"",
    "check": "node --test \"tests/**/*.test.*js\""
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "Superdao (https://github.com/deestax)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T3-Venture-Labs-Limited/ohmydsh.git",
    "directory": "packages/browser-takeover"
  },
  "homepage": "https://github.com/T3-Venture-Labs-Limited/ohmydsh/tree/main/packages/browser-takeover#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/T3-Venture-Labs-Limited/ohmydsh/issues"
  }
}
