{
  "name": "dsh-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Source-copied UI kit, token linter and plugin template for DSH plugins",
  "license": "MIT",
  "author": "Superdao (https://github.com/deestax)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deestax/dsh-kit.git"
  },
  "bugs": {
    "url": "https://github.com/deestax/dsh-kit/issues"
  },
  "homepage": "https://github.com/deestax/dsh-kit#readme",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ui tests lint scripts build && node lint/token-lint.mjs ui",
