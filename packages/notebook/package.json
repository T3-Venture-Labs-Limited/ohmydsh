{
  "name": "dsh-notebook",
  "version": "0.1.0",
  "description": "Jupyter notebooks in the DSH sidebar that you and the agent run together: one host-owned ipykernel per notebook, live updates, approval-aware execution.",
  "license": "Apache-2.0",
  "author": "Superdao (https://github.com/deestax); fork of kikulmj/dsh-jupyter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deestax/dsh-notebook.git"
  },
  "bugs": {
    "url": "https://github.com/deestax/dsh-notebook/issues"
  },
  "homepage": "https://github.com/deestax/dsh-notebook#readme",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "python",
    "skills",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsdown && node scripts/check-artifacts.mjs && node tools/token-lint.mjs src lib",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts tsdown.config.ts && node tools/token-lint.mjs src",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "katex": "0.16.22",
    "oxlint": "1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
