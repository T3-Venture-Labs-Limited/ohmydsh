+/* Social post previews. Surfaces and text follow the host theme tokens (light
+   and dark); only the platforms' brand accents are literal. */
+.social {
+  --social-text: var(--dsw-alias-label-primary, #0f1419);
+  --social-muted: var(--dsw-alias-label-secondary, #536471);
+  --social-border: var(--dsl-g-border, #cfd9de);
+  --social-surface: var(--dsl-g-surface, #fff);
+  box-sizing: border-box;
+  min-width: 0;
+  color: var(--social-text);
+  background: var(--social-surface);
+  border: 1px solid var(--social-border);
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
+  text-align: left;
+}
+
+.avatar {
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  object-fit: cover;
+  color: #fff;
+  font-weight: 700;
+  line-height: 1;
+  user-select: none;
+}
+
+.entity { color: var(--social-link); }
+
+.media { display: grid; gap: 2px; overflow: hidden; border: 1px solid var(--social-border); }
+.media img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; background: var(--dsl-g-tint, rgb(0 0 0 / 4%)); }
+.media[data-count='1'] img { max-height: 510px; height: auto; }
+.media[data-count='2'] { grid-template-columns: 1fr 1fr; aspect-ratio: 16 / 9; }
+.media[data-count='3'] { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; aspect-ratio: 16 / 9; }
+.media[data-count='3'] img:first-child { grid-row: span 2; }
+.media[data-count='4'] { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; aspect-ratio: 16 / 9; }
+
+/* ---------------- X ---------------- */
+.x {
+  --social-link: #1d9bf0;
+  max-width: 598px;
+  border-radius: 16px;
+  overflow: hidden;
+}
+.xPost { display: flex; gap: 12px; padding: 12px 16px 4px; }
+.xPost + .xPost { padding-top: 4px; }
+.xGutter { display: flex; flex-direction: column; align-items: center; flex: none; width: 40px; }
+.threadLine { flex: 1; width: 2px; min-height: 12px; margin-top: 4px; margin-bottom: -8px; background: var(--social-border); border-radius: 1px; }
+.xBody { flex: 1; min-width: 0; padding-bottom: 8px; }
+.xHeader { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; font-size: 15px; line-height: 20px; min-width: 0; }
+.xName { font-weight: 700; overflow-wrap: anywhere; }
+.xMeta { color: var(--social-muted); }
+.verified { width: 18px; height: 18px; color: #1d9bf0; flex: none; }
+.xText {
+  margin-top: 2px;
+  font-size: 15px;
+  line-height: 20px;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.xMedia { margin-top: 12px; border-radius: 16px; }
+.xQuote { margin-top: 12px; padding: 12px; border: 1px solid var(--social-border); border-radius: 16px; }
+.xQuoteText { margin-top: 2px; font-size: 15px; line-height: 20px; white-space: pre-wrap; overflow-wrap: anywhere; }
+.xFooter { display: flex; justify-content: flex-end; margin-top: 8px; }
+.counter { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; line-height: 16px; color: var(--social-muted); font-variant-numeric: tabular-nums; }
+.counterTrack { fill: none; stroke: var(--social-border); stroke-width: 2; }
+.counterFill { fill: none; stroke: #1d9bf0; stroke-width: 2; stroke-linecap: round; }
+.counter[data-level='near'] .counterFill { stroke: #ffad1f; }
+.counter[data-level='near'] .counterText { color: #c98a00; }
+.counter[data-level='over'] .counterFill { stroke: #f4212e; }
+.counter[data-level='over'] .counterText { color: #f4212e; font-weight: 700; }
+.summary { padding: 8px 16px 12px 68px; font-size: 13px; color: #f4212e; font-weight: 600; }
+
+/* ---------------- LinkedIn ---------------- */
+.linkedinWrap { display: grid; gap: 8px; max-width: 555px; min-width: 0; }
+.linkedinWrap[data-device='mobile'] { max-width: 390px; }
+.linkedin {
+  --social-link: #0a66c2;
+  border-radius: 8px;
+  padding-bottom: 4px;
+  overflow: hidden;
+}
+.liHeader { display: flex; gap: 8px; padding: 12px 16px 0; }
+.liAuthor { display: flex; flex-direction: column; min-width: 0; }
+.liName { font-size: 14px; line-height: 20px; font-weight: 600; overflow-wrap: anywhere; }
+.liHeadline, .liMeta { font-size: 12px; line-height: 16px; color: var(--social-muted); overflow-wrap: anywhere; }
+.liHeadline { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.liMeta { display: inline-flex; align-items: center; gap: 4px; }
+.globe { flex: none; }
+.liText {
+  padding: 8px 16px 0;
+  font-size: 14px;
+  line-height: 20px;
+  overflow-wrap: anywhere;
+}
+.liInline { display: inline; white-space: pre-wrap; }
+.seeMore {
+  display: inline;
+  margin: 0 0 0 2px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--social-muted);
+  font: inherit;
+  font-weight: 600;
+  cursor: pointer;
+}
+.seeMore:hover { color: var(--social-link); text-decoration: underline; }
+.seeMore:focus-visible, .deviceSwitch button:focus-visible { outline: 2px solid var(--dsl-g-accent, #0a66c2); outline-offset: 2px; border-radius: 2px; }
+.liMedia { margin-top: 8px; border-left: 0; border-right: 0; }
+.liActions {
+  display: flex;
+  justify-content: space-around;
+  margin: 8px 16px 0;
+  padding-top: 6px;
+  border-top: 1px solid var(--social-border);
+  font-size: 14px;
+  line-height: 20px;
+  font-weight: 600;
+  color: var(--social-muted);
+}
+.liActions span { padding: 6px 8px; }
+.linkedinWrap[data-device='mobile'] .liActions { font-size: 12px; }
+
+.foldBar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: var(--dsl-g-font-meta, 12px); color: var(--dsw-alias-label-secondary, #667085); }
+.foldNote { flex: 1 1 260px; line-height: 1.45; }
+.foldNote[data-level='over'] { flex-basis: 100%; color: var(--dsw-alias-state-error-primary, #b42318); font-weight: 600; }
+.deviceSwitch { display: inline-flex; border: 1px solid var(--dsl-g-border, #c6ced8); border-radius: 999px; overflow: hidden; }
+.deviceSwitch button { padding: 3px 10px; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; }
+.deviceSwitch button[aria-pressed='true'] { background: var(--dsl-g-tint-strong, var(--dsl-g-hover, rgb(0 0 0 / 8%))); color: var(--dsw-alias-label-primary, inherit); font-weight: 600; }
